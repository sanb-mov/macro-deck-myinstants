<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/nameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name (optional)"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/hostField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Host or IP (e.g. 192.168.1.20)"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/portField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Port"
            android:inputType="number"
            android:singleLine="true" />

        <EditText
            android:id="@+id/tokenField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Token (optional)"
            android:inputType="text"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/sslField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use SSL (wss://)" />

        <CheckBox
            android:id="@+id/autoConnectField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect automatically on start" />

    </LinearLayout>

</ScrollView>
